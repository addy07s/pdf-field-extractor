# Vision backend selector: cloud (Gemini) or ollama (local).
VISION_PROVIDER=cloud

# Gemini API key (placeholder only, never commit real keys).
GEMINI_API_KEY=your-gemini-api-key-here
# Gemini model name used when VISION_PROVIDER=cloud.
GEMINI_MODEL=gemini-2.5-flash

# Max parallel docs; keep 1 on free-tier quotas.
BATCH_CONCURRENCY=1

# Optional Ollama settings used only when VISION_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava
